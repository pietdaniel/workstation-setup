{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "external_directory": {
      "*": "ask",
      "~/go/**": "allow",
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
      "/var/folders/*/*/T/*/**": "allow",
      "/Users/*/.config/opencode/**": "allow"
    }
  },
  "plugin": [
    "@mohak34/opencode-notifier@latest"
  ]
}
