prefix_rule(pattern=["./gradlew", ":app:compileDebugKotlin"], decision="allow")
prefix_rule(pattern=["./gradlew", ":app:assembleDebug"], decision="allow")
prefix_rule(pattern=["rg"], decision="allow")
prefix_rule(pattern=["./gradlew", ":app:testDebugUnitTest"], decision="allow")
prefix_rule(pattern=["nix", "develop", "--command"], decision="allow")
prefix_rule(pattern=["/bin/zsh", "-lc", "nix develop --command adb logcat -d -t 600 AndroidRuntime:E *:S"], decision="allow")
